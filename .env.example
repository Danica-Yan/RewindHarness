# Copy to .env and fill in. .env is git-ignored.

# Real-model runs (rewind run --provider deepseek, scripts/run_taubench_*.sh)
DEEPSEEK_API_KEY=
# rewind run --provider anthropic
ANTHROPIC_API_KEY=

# Infrastructure tests (defaults shown)
REWIND_PG_DSN=postgresql://rewind:rewind@127.0.0.1:5432/rewind_test
REWIND_REDIS_URL=redis://127.0.0.1:6379/0
